      "parameters": {
        "operation": "toText",
        "sourceProperty": "linea",
        "options": {}
      }
    },
    {
      "id": "n12",
      "name": "Escribir traza (archivo)",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1.1,
      "position": [
        2500,
        100
      ],
      "parameters": {
        "operation": "write",
        "fileName": "/data/n8n/traza_agente_solucion.jsonl",
        "options": {
          "append": true
        }
      }
    },
    {
      "id": "n13",
      "name": "Publicar (Mosquitto)",
      "type": "n8n-nodes-base.mqtt",
      "typeVersion": 1,
      "position": [
        2720,
        100
      ],
      "parameters": {
        "topic": "linea/est01/agente/solucion",
        "sendInputData": false,
        "message": "={{ $('Registro de traza').item.json.linea }}",
        "options": {}
      },
      "credentials": {
        "mqtt": {
          "name": "Mosquitto de la línea"
        }
      }
    },
    {
      "id": "n14",
      "name": "Respuesta",
